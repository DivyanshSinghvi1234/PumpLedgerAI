# ─────────────────────────────────────────────────────────────
# PumpLedgerAI – Backend Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=PumpLedger API
APP_VERSION=1.0.0
DEBUG=False

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (Neon PostgreSQL) ───────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs (no trailing slash)
# Example: https://pumpledger-frontend.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=

# ── AI Keys ──────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -urlsafe-base64 32
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Default Admin (used only on first startup) ───────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
DEFAULT_ADMIN_FULL_NAME=Administrator
